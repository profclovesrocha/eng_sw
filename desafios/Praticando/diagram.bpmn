    <bpmn:task id="Activity_05dm9wq" name="A equipe correu ate 1954 com resultados constantes">
      <bpmn:incoming>Flow_0s9hc3f</bpmn:incoming>
      <bpmn:outgoing>Flow_1d46gsz</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_0s9hc3f" name="Progresso da equipe ao longo dos anos" sourceRef="Activity_0tqmeqr" targetRef="Activity_05dm9wq" />
    <bpmn:exclusiveGateway id="Gateway_0ta4abz" name="Retorno da equipe em 1956">
      <bpmn:incoming>Flow_1d46gsz</bpmn:incoming>
      <bpmn:outgoing>Flow_16id6ov</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1d46gsz" sourceRef="Activity_05dm9wq" targetRef="Gateway_0ta4abz" />
    <bpmn:task id="Activity_00007tr" name="Continuou correndo constantemente ate o seu fim em 2000">
      <bpmn:incoming>Flow_16id6ov</bpmn:incoming>
      <bpmn:outgoing>Flow_0vuu0e5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_16id6ov" sourceRef="Gateway_0ta4abz" targetRef="Activity_00007tr" />
    <bpmn:endEvent id="Event_18s8pt0" name="A equipe abandonou oficialmente o campeonato em Le mans no ano de 2001">
      <bpmn:incoming>Flow_0vuu0e5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0vuu0e5" sourceRef="Activity_00007tr" targetRef="Event_18s8pt0" />
    <bpmn:startEvent id="Event_07niv50" name="Sauber Mercedes">
      <bpmn:outgoing>Flow_1axu6h3</bpmn:outgoing>
      <bpmn:outgoing>Flow_14vz8le</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1axu6h3" sourceRef="Event_07niv50" targetRef="Gateway_0tpi7d7" />
    <bpmn:sequenceFlow id="Flow_14vz8le" sourceRef="Event_07niv50" targetRef="Gateway_0voj1ep" />
    <bpmn:textAnnotation id="TextAnnotation_0b5itti">
      <bpmn:text>Estreia da equipe em 1952, onde seus carros receberam o apelido de "Flecha de prata"</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1fvx7qa">
      <bpmn:text>Os pilotos  Hermann Lang
e Fritz Riess venceram a corrida com 277 pilotando o Mercedes-Benz 300SL</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_10alg3p" associationDirection="None" sourceRef="Activity_0tqmeqr" targetRef="TextAnnotation_1fvx7qa" />
    <bpmn:textAnnotation id="TextAnnotation_0vitgfx">
      <bpmn:text>Curiosidade: O Carro antes do início da corrida pesava mais que o permitido, e a solução tomada foi raspar a pintura inteira do carro deixando apenas o alumínio da carroceria exposto</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1t9l02u" associationDirection="None" sourceRef="Activity_1gubcbd" targetRef="TextAnnotation_0vitgfx" />
    <bpmn:textAnnotation id="TextAnnotation_0kubnbv">
      <bpmn:text>A equipe abandonou a corrida de 1955 apos um grave acidente na pista</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0rhkmcu" associationDirection="None" sourceRef="Activity_05dm9wq" targetRef="TextAnnotation_0kubnbv" />
    <bpmn:textAnnotation id="TextAnnotation_0qxs97s">
      <bpmn:text>Em 1999 um acidente envolvendo o protótipo CLR GTR fez com que a equipe abandonasse mais uma vez a corrida</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1j3bzcs" associationDirection="None" sourceRef="Activity_00007tr" targetRef="TextAnnotation_0qxs97s" />
    <bpmn:association id="Association_1qrvk25" associationDirection="None" sourceRef="TextAnnotation_0b5itti" targetRef="Event_07niv50" />
  </bpmn:process>
