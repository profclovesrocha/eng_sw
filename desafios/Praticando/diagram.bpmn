  <bpmn:process id="Process_02h8x6e" isExecutable="false">
    <bpmn:task id="Activity_0tqmeqr" name="Equipe conquistaria o 1 e 2 colocado nas 24H de Le mans">
      <bpmn:incoming>Flow_0m99cp2</bpmn:incoming>
      <bpmn:incoming>Flow_1156oql</bpmn:incoming>
      <bpmn:outgoing>Flow_0s9hc3f</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_0tpi7d7" name="Caso largue bem">
      <bpmn:incoming>Flow_1axu6h3</bpmn:incoming>
      <bpmn:outgoing>Flow_0e5zipy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_0voj1ep" name="Caso largue mal">
      <bpmn:incoming>Flow_14vz8le</bpmn:incoming>
      <bpmn:outgoing>Flow_0tn5zgx</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_1c7qkxs" name="Equipe encerra as atividades">
      <bpmn:incoming>Flow_15o5p3m</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Activity_1gubcbd" name="O Carro consegue manter voltas rápidas e constantes">
      <bpmn:incoming>Flow_0e5zipy</bpmn:incoming>
      <bpmn:outgoing>Flow_0m99cp2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_0e5zipy" sourceRef="Gateway_0tpi7d7" targetRef="Activity_1gubcbd" />
    <bpmn:sequenceFlow id="Flow_0m99cp2" sourceRef="Activity_1gubcbd" targetRef="Activity_0tqmeqr" />
    <bpmn:task id="Activity_0169mao" name="Mesmo com a potencia alta, o carro não consegue ser constante">
      <bpmn:incoming>Flow_0tn5zgx</bpmn:incoming>
      <bpmn:outgoing>Flow_1y2m4mc</bpmn:outgoing>
      <bpmn:outgoing>Flow_0te27xt</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_0tn5zgx" sourceRef="Gateway_0voj1ep" targetRef="Activity_0169mao" />
    <bpmn:exclusiveGateway id="Gateway_1knipas" name="Caso o piloto se acalme e controle o carro">
      <bpmn:incoming>Flow_1y2m4mc</bpmn:incoming>
      <bpmn:outgoing>Flow_1156oql</bpmn:outgoing>
    </bpmn:exclusiveGateway>
