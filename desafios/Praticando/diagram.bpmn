    <bpmn:exclusiveGateway id="Gateway_14su15c" name="Caso o piloto continue nervoso">
      <bpmn:incoming>Flow_0te27xt</bpmn:incoming>
      <bpmn:outgoing>Flow_15o5p3m</bpmn:outgoing>
    </bpmn:exclusiveGateway>
