    <task id="Task_CancelarDevolver" name="Cancelar / Devolver pedido">
      <incoming>Flow_Notificar_CancelarDev</incoming>
      <outgoing>Flow_CancelarDev_End</outgoing>
    </task>
    <endEvent id="EndEvent_CancelPagamento" name="Cancelado (pagamento recusado)">
